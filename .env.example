PORT=3000

# Docker only: the uid/gid the server drops to. It has to be able to write the
# mounted volumes — a bind mount keeps its host ownership, so whatever owns
# ./db, ./music and ./ingest on the host is what this must match.
#   `id -u; id -g`   on a normal Linux host (usually 1000:1000, the default)
#   99:100           on Unraid, whose shares are owned by nobody:users
# The container fixes up the database directory itself on start; your music
# directory is left alone, and the server says so on startup if it can't write.
# PUID=1000
# PGID=1000

# Set when running behind a reverse proxy you control, so the app trusts
# X-Forwarded-For / X-Forwarded-Proto (accepts anything Express's `trust proxy`
# setting takes, e.g. 1, or a subnet like 10.0.0.0/8). Leave unset for a
# directly-exposed process: it makes the app trust headers any client can send.
# TRUST_PROXY=1

# Optional: override the yt-dlp binary name/path if it's not on PATH as `yt-dlp`.
YTDLP_PATH=yt-dlp

# Required: MusicBrainz requires a real contact email in the User-Agent
# string of every request, per their API usage policy.
MB_CONTACT_EMAIL=you@example.com
MB_APP_NAME=Spinmatch
MB_APP_VERSION=0.1.0

# Optional: base URL of a MeTube instance (https://github.com/alexta69/metube).
# When set, a "Send to MeTube" button appears next to YouTube results, posting
# the video URL to {METUBE_URL}/add from the browser. Leave blank to hide it.
METUBE_URL=

# Optional: local library ingest feature. INGEST_DIR and MUSIC_DIR must both
# be set to enable it — see README for setup. ACOUSTID_API_KEY is separately
# optional: it turns on automatic fingerprint-based identification. Without it,
# ingest falls back to matching files by the tags they already carry (confirmed
# against MusicBrainz by title and duration); anything that doesn't confirm is
# listed for manual review instead.
ACOUSTID_API_KEY=
# Paths the app itself reads (container-side paths if using docker-compose;
# for non-Docker/local use, point these at whatever real paths you want).
INGEST_DIR=/data/ingest
MUSIC_DIR=/data/music
# Optional: override the fpcalc (Chromaprint) binary path.
FPCALC_PATH=fpcalc
# Docker Compose only: host-side folders bind-mounted to INGEST_DIR/MUSIC_DIR
# above. Not read by the app itself.
INGEST_HOST_DIR=./ingest
MUSIC_HOST_DIR=./music

# Optional: path to the SQLite database. It always holds the admin login, plus
# the library index when MUSIC_DIR is set. Leave unset to use the default: the
# Docker image points it at /data/db/library.db (a mounted volume); a local
# non-Docker run falls back to ./data/library.db under the working directory.
# LIBRARY_DB=/data/db/library.db
# Docker Compose only: host-side folder bind-mounted to hold library.db.
DB_HOST_DIR=./db

# Optional: matching thresholds. Defaults are the values the app shipped with;
# these only exist so they can be tuned without editing code.
# AcoustID scores 0-1: the minimum fingerprint confidence to consider a match.
# ACOUSTID_MIN_SCORE=0.5
# MusicBrainz artist search scores 0-100: at or above this an artist name is
# resolved automatically, below it you are asked to pick.
# ARTIST_AUTO_ACCEPT_SCORE=90
# How far a candidate's length may differ from the expected length, in ms.
# DURATION_TOLERANCE_MS=5000

# Optional: the Discovery tab's "sounds like" signal comes from ListenBrainz.
# It needs no API key and sends nothing about you — it only asks which artists
# are similar to a given MusicBrainz artist id. It lives on an experimental
# subdomain, so set this to 0 to turn it off; Discovery then runs on the
# MusicBrainz relationship graph alone rather than breaking.
# LISTENBRAINZ_ENABLED=1

# Optional. Where "export to player" copies a playlist's files, ready to be
# moved onto an MP3 player. Unset hides the feature. Keep it outside MUSIC_DIR:
# the copies would otherwise sit on the music volume and be indexed as
# duplicates.
DROPOFF_DIR=
